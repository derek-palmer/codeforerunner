# forerunner.config.yaml
# Copy this file to forerunner.config.yaml and fill in your values.

provider: anthropic          # anthropic | openai | google | ollama
model: claude-opus-4-5       # any model your provider supports
api_key_env:
  anthropic: ANTHROPIC_API_KEY
  openai: OPENAI_API_KEY
  google: GOOGLE_API_KEY
output_dir: docs
context_max_files: 30
context_max_lines_per_file: 300
approaching_eol_threshold_months: 6

ignore_patterns:
  - "*.test.ts"
  - "fixtures/"
  - "mocks/"

tasks:
  version_audit:
    enabled: true
    stale_after_days: 30
    fetch_live_eol_data: false   # set true to call endoflife.date API at runtime
  check:
    block_on: [HIGH, MEDIUM]     # severity levels that block commit
    warn_on: [LOW]
