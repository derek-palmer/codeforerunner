# forerunner.config.yaml
# Copy this file to forerunner.config.yaml and fill in your values.

approaching_eol_threshold_months: 6

ignore_patterns:
  - "*.test.ts"
  - "fixtures/"
  - "mocks/"

tasks:
  version_audit:
    enabled: true
    stale_after_days: 30
    fetch_live_eol_data: false   # set true to call endoflife.date API at runtime
  check:
    block_on: [HIGH, MEDIUM]     # severity levels that block commit
    warn_on: [LOW]
